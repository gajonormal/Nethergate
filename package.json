{
  "name": "nethergate-hub",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "format": "prettier --write ui scripts tests index.html vite.config.ts tsconfig.json package.json .github src-tauri/tauri.conf.json",
    "format:check": "prettier --check ui scripts tests index.html vite.config.ts tsconfig.json package.json .github src-tauri/tauri.conf.json",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "package:windows": "tauri build --bundles nsis",
    "test:ui": "npm run build && node scripts/test-ui.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "license": "GPL-3.0-only"
}
